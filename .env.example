# ---------------------------------------------------------------------------
# worker-gpu
# ---------------------------------------------------------------------------
# Copie para `.env` e ajuste. O `instalar.sh` recusa subir com os valores que
# nao funcionam, em vez de deixar o servico morrer no boot.

# --- Rede ------------------------------------------------------------------
# Endereco de escuta.
#
#   127.0.0.1           atende so esta maquina
#   $(tailscale ip -4)  atende os outros clientes pela rede privada
#
# NUNCA 0.0.0.0: isso publica na internet um endpoint que roda modelo na sua
# placa. O instalador recusa.
#
# O valor precisa ser um endereco que EXISTA nesta maquina — o instalador
# tenta escutar nele antes de instalar a unit.
BIND_HOST=127.0.0.1
BIND_PORT=8090

# Segredo compartilhado com todos os clientes. Gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
WORKER_SHARED_SECRET=

# --- Ollama (texto) --------------------------------------------------------
# O worker e o UNICO que fala com o Ollama. Deixe o Ollama em loopback: quem
# publica na rede e o worker, que arbitra a placa.
OLLAMA_URL=http://127.0.0.1:11434

# Orcamento de tempo de UM pedido de texto, em segundos.
#
# 540 e nao 600 de proposito: o INTEGRACAO.md sugere 600s de timeout no
# cliente, e os dois relogios nao comecam juntos — o do cliente parte quando
# ele envia, o daqui so depois de o pedido chegar e tomar o lock. Iguais, quem
# desiste primeiro e o cliente, e ele abandona um trabalho que ainda esta
# segurando a placa. Deixe este MENOR que o timeout dos clientes.
OLLAMA_TIMEOUT=540

# Descarregar o modelo de texto da VRAM antes de um trabalho de imagem.
#
# E o ponto de o arbitro existir. Numa placa de 8 GB um modelo grande ocupa
# quase tudo e a difusao precisa de ~5,4 GB — nao cabem juntos. Como todo
# pedido passa pelo worker, descarregar e seguro: detendo o lock, ninguem
# esta gerando texto.
OLLAMA_DESCARREGAR_PARA_IMAGEM=sim

# Baixar sozinho um modelo pedido que nao esta no disco.
#
# Com um modelo por cliente, lembrar de dar `ollama pull` em cada um a cada
# maquina nova nao escala — e esquecer aparece como 404 no meio de um lote. O
# worker baixa EM SEGUNDO PLANO, sem tomar a placa: imagem e conversao seguem
# funcionando. O pedido que disparou leva 503 `baixando_modelo`.
#
# Desligue num disco apertado ou numa maquina sem saida para a internet: um
# nome de modelo errado que por acaso exista no registro baixa gigabytes que
# ninguem pediu.
BAIXAR_MODELO_AUTOMATICO=sim

# Teto para UM download, em segundos. Um modelo grande numa conexao domestica
# passa de meia hora, e desistir no meio joga fora o que ja veio.
OLLAMA_PULL_TIMEOUT=3600

# Por quanto tempo um download que FALHOU e lembrado, em segundos. Sem memoria
# da falha, cada retentativa do cliente dispara um download novo do mesmo
# modelo que nao existe. Com memoria eterna, uma queda de rede exigiria
# reiniciar o servico.
FALHA_DE_DOWNLOAD_LEMBRADA=600

# Nao ha OLLAMA_KEEP_ALIVE aqui, e a ausencia e deliberada. Ele existia, era
# injetado no corpo de cada pedido de texto, e a camada compativel do Ollama o
# descartava — `keep_alive` nao e campo do dialeto da OpenAI. Parecia ativo e
# nao fazia nada.
#
# O lugar de ajustar isso e o ambiente do PROPRIO Ollama. Idem para a janela de
# contexto: OLLAMA_CONTEXT_LENGTH la, ou `PARAMETER num_ctx` num Modelfile —
# um `options.num_ctx` mandado pelo cliente tambem e descartado.

# --- Imagem ----------------------------------------------------------------
IMAGEM_ATIVA=sim
# O modelo. O SDXL base e o padrao porque e o que existe sem escolha, e nao
# porque e o melhor: ele e de 2023 e um dos piores da familia para foto
# realista. Um ajuste fino da MESMA familia troca sem mexer em codigo, sem
# mudar a VRAM, e a diferenca em realismo e grande:
#
#   SG161222/RealVisXL_V5.0          foto realista, o mais direto
#   RunDiffusion/Juggernaut-XL-v9    idem, outro gosto
#
# Compare ANTES de decidir, e olhe as imagens:
#   ./venv/bin/python bancada.py --modelos <um>,<outro>
IMAGEM_MODELO=stabilityai/stable-diffusion-xl-base-1.0
IMAGEM_DEVICE=auto

# Passos e guidance. Mais passos e mais tempo, e passa de um ponto onde nao
# melhora; guidance alto satura a cor e endurece a pele.
IMAGEM_PASSOS=30
IMAGEM_GUIDANCE=6.0

# VAE alternativo. VAZIO E UM DEFEITO SILENCIOSO NA FAMILIA SDXL: o VAE que vem
# no SDXL estoura em float16 (que e como o servico carrega na placa) e produz
# manchas, faixas de cor e as vezes imagem preta. O worker avisa no journal
# quando detecta isso.
#
# Para SDXL e qualquer ajuste fino dele (RealVisXL, Juggernaut-XL, ...):
IMAGEM_VAE=madebyollin/sdxl-vae-fp16-fix

# Amostrador. Vazio = o do modelo (Euler, no SDXL). `dpm++2m_karras` costuma
# dar em 30 passos o que o Euler da em 50. Nomes em `imagem.SCHEDULERS`.
IMAGEM_SCHEDULER=dpm++2m_karras

IMAGEM_OCIOSO_SEGUNDOS=300
IMAGEM_MAXIMO=4

# Lado maximo aceito num pedido.
#
# 1536 e nao 1024: o SDXL foi treinado numa grade de proporcoes a area
# constante (~1,05 MP), e a mais larga dela e 1536x640. Com o teto em 1024 as
# proporcoes largas voltavam 422 e so dava para pedir a quadrada, que e a pior
# escolha para uma capa.
IMAGEM_LADO_MAXIMO=1536

# Area maxima de UMA imagem, em megapixels.
#
# Os dois tetos precisam existir: sozinho, um teto de lado em 1536 deixaria
# passar 1536x1536, que e o dobro da area de treino do modelo e VRAM que uma
# placa de 8 GB nao tem. 1,2 deixa a grade inteira passar com folga.
IMAGEM_AREA_MAXIMA_MP=1.2

# Gerar em CPU quando a VRAM nao couber.
#
# DESLIGADO de proposito. Medido nesta configuracao: um lote em CPU consumiu
# horas de processador e 17 GB de RAM (float32), com a maquina inutilizavel.
# Desligado, o pedido volta para a fila do cliente e sai quando a placa vagar.
#
# Meca antes de ligar:  ./venv/bin/python medir_imagem.py --cpu
IMAGEM_PERMITIR_CPU=nao

# Teto por geracao, em segundos. 0 desliga.
#
# Sem ele nao ha como interromper o laco de difusao, e um `systemctl restart`
# fica preso ate o TimeoutStopSec da unit.
IMAGEM_TEMPO_MAXIMO=600

# --- Conversao de PDF ------------------------------------------------------
CONVERSAO_ATIVA=sim
DOCLING_DEVICE=auto
# Threads na CPU. Ignorado em GPU. 0 deixa o Docling decidir.
DOCLING_THREADS=0
# OCR le a imagem da pagina, para PDF digitalizado sem camada de texto. E de
# longe a parte mais cara e a maioria dos artigos nao precisa.
DOCLING_OCR=nao

# Devolver a memoria do conversor depois de um tempo sem pedido, em segundos.
# 0 = fica residente (o comportamento de antes da 2.5).
#
# O Docling ficava carregado PARA SEMPRE depois da primeira conversao — a rota
# de imagem tinha o seu IMAGEM_OCIOSO_SEGUNDOS e esta nao tinha nada. Sao 1 a 2
# GB de memoria anonima parada, e anonima parada e o que o kernel manda para o
# swap primeiro. Veja "Convivendo com a maquina" no README.
#
# Mais alto que o da imagem de proposito: recarregar custa dezenas de segundos
# e PDF costuma vir em lote.
CONVERSAO_OCIOSO_SEGUNDOS=900
MAX_PDF_BYTES=104857600

# --- Memoria: o worker morre antes de levar a maquina ----------------------
# Lidos pelo `instalar.sh` e gravados na unit do systemd. Nao valem a quente:
# `MemoryMax=` nao expande variaveis de ambiente, entao trocar aqui exige
# rodar `./deploy/instalar.sh` de novo.
#
# O freio (`High`): acima dele o kernel reclama paginas com agressividade e o
# processo desacelera, sem morrer.
# A parede (`Max`): acima dela ele morre — e morrer aqui e ACEITAVEL, porque o
# Restart=always sobe de novo em 10s, o lock da GPU morre com o processo e os
# clientes tratam conexao cortada como adiavel. Pior que morrer e arrastar a
# maquina inteira.
#
# 10/14 numa maquina de 32 GB com um modelo de 30B ao lado. Confira o que ele
# realmente usa antes de apertar:
#     curl -s http://127.0.0.1:8090/health/ | jq .memoria
WORKER_MEMORY_HIGH=10G
WORKER_MEMORY_MAX=14G

# --- Arbitragem ------------------------------------------------------------
# Quanto esperar pelo lock antes de devolver 503. Zero = recusa na hora.
#
# Zero e o padrao: os clientes tem fila propria e duravel, e esperar aqui so
# consome conexao dos dois lados para chegar no mesmo lugar. Subir para 2 ou 3
# absorve disputa fina sem virar fila.
ESPERA_PELO_LOCK=0

# Estimativas para o `Retry-After`, em segundos. Nao precisam ser exatas: elas
# evitam mandar o cliente voltar em 60s quando falta meio segundo.
ESTIMATIVA_TEXTO=30
ESTIMATIVA_IMAGEM=60
ESTIMATIVA_CONVERSAO=40
