# Aviso na tela quando o worker morre. Opcional, e so na unit de usuario.
#
#   WORKER_AVISO_QUEDA=sim      no .env
#   ./deploy/instalar.sh        copia esta unit e liga o `OnFailure=` do worker
#
# Nao instale a mao: o `instalar.sh` reescreve a unit do worker a cada rodada,
# e e ele quem decide se o `OnFailure=` entra.
#
# Testar sem derrubar nada:   systemctl --user start worker-gpu-aviso.service
# Testar uma queda de verdade: systemctl --user kill -s KILL worker-gpu.service
#
# O `OnFailure=` dispara a cada queda, mesmo com `Restart=always`, a partir do
# systemd 254 (`systemctl --version`). Mais antigo que isso, confira com o
# `kill` acima antes de contar com ele.
#
# Por que existe: o worker morre em silencio quando estoura o `MemoryMax`, e
# `Restart=always` o traz de volta em 10s. Isso e o desenho funcionando — mas
# se ele estiver morrendo em laco, o unico lugar que conta e o journal, e
# ninguem le o journal sem motivo. Um aviso na tela e o motivo.
#
# Nao trata nada: so avisa. Quem conserta e voce, com o numero que o
# `/health/` publica em `memoria.rss_mb` e `memoria.swap_mb`.

[Unit]
Description=Avisa na tela que o worker-gpu caiu

[Service]
Type=oneshot
# `--urgency=critical` para a notificacao nao sumir sozinha: um aviso que
# desaparece enquanto voce olha para outro monitor nao avisou nada.
ExecStart=/usr/bin/notify-send --urgency=critical --icon=dialog-warning \
    "worker-gpu caiu" \
    "Provavelmente memoria (MemoryMax). Ele volta em 10s. Veja: journalctl --user -u worker-gpu -n 40"
